# Generated by "pnpm generate:env-example".
# Edit packages/configuration/src/environment-schema.ts instead of this file.

# Runtime mode. Production enables the stricter safety checks.
NODE_ENV=development

# Port the HTTP API listens on.
HTTP_PORT=3000

# Interface the HTTP API binds to.
HTTP_HOST=0.0.0.0

# Base URL the dashboard and API documentation are reached on.
# Required.
HTTP_PUBLIC_BASE_URL=http://localhost:8080

# Maximum accepted request body size.
HTTP_BODY_LIMIT_BYTES=1048576

# Time an inbound request may take before it is aborted.
HTTP_REQUEST_TIMEOUT_MILLISECONDS=30000

# Connection string for the runtime role. It assumes a restricted role, subject to row level security, for the duration of each API-key request.
# Required.
DATABASE_APPLICATION_URL=postgres://platform_application:platform_application_password@localhost:55432/notifications

# Connection string for the role that owns the schema and applies migrations. As the owner it is exempt from the row level security policies.
# Required.
DATABASE_SYSTEM_URL=postgres://platform_system:platform_system_password@localhost:55432/notifications

# Maximum connections held per pool.
DATABASE_MAX_POOL_SIZE=10

# Server-side statement timeout for the application role.
DATABASE_STATEMENT_TIMEOUT_MILLISECONDS=5000

# Postgres schema that holds the job queue tables.
QUEUE_SCHEMA=pgboss

# Jobs a single worker process handles concurrently.
QUEUE_CONCURRENCY=5

# How often a worker polls for newly available jobs.
QUEUE_POLLING_INTERVAL_SECONDS=2

# Time in-flight jobs are given to finish when the worker is asked to stop, before it exits anyway.
QUEUE_SHUTDOWN_TIMEOUT_SECONDS=30

# How long a notification may stay undelivered before it is failed. A message pending for a day is no longer the message the caller meant to send.
DELIVERY_MAXIMUM_LIFETIME_HOURS=24

# How long a dispatch claim may be held before it is treated as abandoned by a crashed worker.
DELIVERY_STUCK_CLAIM_TIMEOUT_SECONDS=300

# Base URL of the WAHA instance, reachable on the internal Docker network.
# Required.
WAHA_BASE_URL=http://waha:3000

# Value sent as the X-Api-Key header to WAHA.
# Required.
WAHA_API_KEY=replace-me-with-a-32-byte-base64-value

# Time a single WAHA request may take before it is aborted.
WAHA_REQUEST_TIMEOUT_MILLISECONDS=30000

# Base URL WAHA calls back with delivery events. Must be reachable from WAHA.
# Required.
WAHA_WEBHOOK_PUBLIC_URL=http://api:3000

# How far a callback timestamp may be from now before it is refused as a replay. A signature never expires on its own.
WAHA_WEBHOOK_TOLERANCE_SECONDS=300

# Server-side pepper for API key hashing. Held outside the database so a dump alone cannot forge keys.
# Required.
SECURITY_API_KEY_PEPPER=replace-me-with-a-32-byte-base64-value

# AES-256-GCM key protecting reversible secrets such as webhook signing keys.
# Required.
SECURITY_ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-value

# Signs pagination cursors so a tampered cursor is rejected rather than executed.
# Required.
SECURITY_CURSOR_SIGNING_KEY=replace-me-with-a-32-byte-base64-value

# Name of the dashboard session cookie.
SECURITY_SESSION_COOKIE_NAME=wnp_session

# Hard session lifetime. Never extended, so a stolen session expires.
SECURITY_SESSION_ABSOLUTE_LIFETIME_SECONDS=2592000

# Sliding idle timeout, extended on use.
SECURITY_SESSION_IDLE_LIFETIME_SECONDS=604800

# Send session cookies only over HTTPS. Required in production.
SECURITY_COOKIE_SECURE=false

# Allow new accounts to be created through the dashboard.
SECURITY_REGISTRATION_ENABLED=true

# Minimum level written to stdout.
LOG_LEVEL=info

# Structured JSON for deployments, pretty for local development.
LOG_FORMAT=json

# Salt for hashing recipient phone numbers in logs, so delivery can be traced without storing personal data.
# Required.
LOG_RECIPIENT_SALT=replace-me-with-a-32-byte-base64-value
