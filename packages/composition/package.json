{
  "name": "@platform/composition",
  "version": "0.1.0",
  "private": true,
  "description": "Binds domain ports to infrastructure adapters. The only place applications wire dependencies.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
