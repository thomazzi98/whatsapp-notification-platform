{
  "name": "@platform/queue",
  "version": "0.1.0",
  "private": true,
  "description": "Durable job queue built on Postgres, including transactional enqueue.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@platform/database": "workspace:*",
    "@platform/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@platform/testing": "workspace:*",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "platform-bootstrap": "./dist/cli/bootstrap.js"
  }
}
