# The pnpm virtual store encodes peer-dependency hashes into directory names,
# which overruns the 260-character Windows path limit on machines where
# LongPathsEnabled is not set. Shortening it keeps installs working there.
virtual-store-dir-max-length=60

# Workspace packages are linked, never fetched from a registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Reproducible installs in CI and in Docker builds.
resolution-mode=highest
