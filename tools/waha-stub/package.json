{
  "name": "@platform/waha-stub",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic stand-in for WAHA, so the delivery pipeline can be tested without a phone.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
